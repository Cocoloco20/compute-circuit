# Copy to .env.local and fill in values from Supabase Dashboard
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Project Settings → API → Project API keys → service_role (secret!)
# Used by seed script and Vercel cron jobs only. NEVER exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Project Settings → Database → Connection string → URI
# Only needed if you ever want to run migrations from the CLI (we're using
# the dashboard SQL editor for now, so this is optional).
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres

# ── Digest / Watchlist ─────────────────────────────────────────────────────

# Resend API key (https://resend.com → API Keys → Create API Key)
RESEND_API_KEY=re_...

# Email address to receive the daily 8am ET digest
DIGEST_EMAIL=you@example.com

# Comma-separated list of company IDs from the DB (companies.id column)
# e.g. the UUID or slug you used when seeding companies.
# Find them: SELECT id, name FROM companies ORDER BY name;
WATCHLIST_CO_IDS=uuid-co-1,uuid-co-2,uuid-co-3

# Secret used by Vercel to authenticate cron job requests (set this in Vercel
# project settings too — Environment Variables → CRON_SECRET).
CRON_SECRET=your-random-secret-here
