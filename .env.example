# ─────────────────────────────────────────────────────────────────────────────
# Compute Circuit env vars
# Copy to .env.local and fill in real values from each provider's dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (https://supabase.com → Project Settings → API) ────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public — safe to ship to browser. Respects RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
# Secret — bypasses RLS. Used by cron jobs + scripts. NEVER expose to browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
# Optional — only needed for direct CLI migrations
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# ── Cron auth ──────────────────────────────────────────────────────────────
# Bearer-checked on /api/cron/* routes. Generate with: openssl rand -hex 32
CRON_SECRET=YOUR_RANDOM_SECRET_HERE

# ── Optional data-source API keys (each is free signup) ────────────────────
EIA_API_KEY=          # https://www.eia.gov/opendata/register.php
USPTO_API_KEY=        # https://data.uspto.gov/myodp (requires ID.me)
ANTHROPIC_API_KEY=    # https://console.anthropic.com/settings/keys (thesis cards)
GITHUB_TOKEN=         # Optional, 60→5000 req/hr rate-limit boost

# ── Logo proxy provider chain (/api/logo/[domain]) ─────────────────────────
# Optional — chain falls through to Clearbit/Google/DuckDuckGo/homepage-scrape
# if either is missing. Provide both for best coverage of niche cos.
BRANDFETCH_CLIENT_ID= # https://brandfetch.com/developers (free tier)
LOGO_DEV_TOKEN=       # https://logo.dev/dashboard (free tier)

# ── Daily email digest (optional) ──────────────────────────────────────────
RESEND_API_KEY=       # https://resend.com (3000 emails/mo free)
DIGEST_EMAIL=         # Where the morning digest is sent
WATCHLIST_CO_IDS=     # Comma-separated company IDs from companies.id

# ── Pooler region override (optional) ──────────────────────────────────────
# If your Supabase project isn't in us-west-1, override here:
POOLER_REGION=us-west-1
